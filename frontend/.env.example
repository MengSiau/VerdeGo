# Copy this file to .env and fill in the values (ask a teammate, or see
# Supabase Dashboard -> Project Settings -> API). Never commit .env.
#
# Variables must be prefixed EXPO_PUBLIC_ to be readable from app code.
# Restart the dev server with a cache clear after editing: npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_API_URL=

# Google Places/Routes API key (ask a teammate). Needs the Places API and
# Routes API enabled in Google Cloud Console. Used by the Post Ride location
# search and journey distance/duration lookup - without it, place search and
# "Vehicle & Green Score" routing will fail.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=